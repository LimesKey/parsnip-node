      "rules": {
        "max_error": 0.005,
        "min_clearance": 0.1,
        "min_connection": 0.1,
        "min_copper_edge_clearance": 0.2,
        "min_groove_width": 0.0,
        "min_hole_clearance": 0.2,
        "min_hole_to_hole": 0.2,
        "min_microvia_diameter": 0.25,
        "min_microvia_drill": 0.15,
