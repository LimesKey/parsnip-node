        "min_silk_clearance": 0.15,
        "min_text_height": 0.8,
        "min_text_thickness": 0.1,
        "min_through_hole_diameter": 0.2,
        "min_track_width": 0.1,
        "min_via_annular_width": 0.15,
        "min_via_diameter": 0.5,
        "solder_mask_to_copper_clearance": 0.005,
        "use_height_for_length_calcs": true
      },
      "teardrop_options": [
        {
          "td_onpthpad": true,
