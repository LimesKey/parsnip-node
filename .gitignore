# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/
#
# NOTE: this repo DELIBERATELY tracks fab outputs (*.gbr, *.drl) and 3D models
# (*.wrl, *.step). Do not add ignores for those.

# ---------------------------------------------------------------------------
# KiCad temporary / backup / autosave
# ---------------------------------------------------------------------------
*.000
*.tmp
*.orig
*.rej
*~
~*
*.bak
*-bak*
*-cache*
*-backups
fp-info-cache
_autosave*
\#auto_saved_files\#
*.lck

# ---------------------------------------------------------------------------
# KiCad generated exports (netlist, autorouter, BOM, reports)
# ---------------------------------------------------------------------------
*.net
*.dsn
*.ses
*.xml
*.csv
*.rpt
*.drc
*.erc
*.pos

# ---------------------------------------------------------------------------
# KiCad local (per-user, not shared)
# ---------------------------------------------------------------------------
*.kicad_prl
*-save.pro
*-save.kicad_pcb
.history

# ---------------------------------------------------------------------------
# Fab / assembly bundles
# ---------------------------------------------------------------------------
/dfm
ibom.html
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.sublime-workspace
*.swp
*.swo
.nfs*

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*
.fuse_hidden*

# ---------------------------------------------------------------------------
# Python (KiCad plugins, action scripts, helper tooling)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.python-version

# ---------------------------------------------------------------------------
# Embedded build output (Arduino / PlatformIO / esptool)
# NOTE: *.log is deliberately NOT ignored: code/*.log flash logs are tracked.
# ---------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
build/
*.elf
*.hex
*.uf2
*.map
node_modules/
npm-debug.log*

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Production fab bundle - tracked for grant/fab submission
# (overrides *.csv line 32 and *.zip line 51 above, scoped to production/ only)
# ---------------------------------------------------------------------------
!production/*.csv
!production/*.zip

# ---------------------------------------------------------------------------
# AI tooling local state
# ---------------------------------------------------------------------------
.claude/settings.local.json
CLAUDE.local.md
.aider*
.serena
.playwright-mcp/
freerouting-*.jar
CLAUDE.md
TODO.md
SKILL-BACKLOG.md
DESIGN-INTENT.md
docs/fab