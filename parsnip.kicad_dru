(version 1)
# parsnip-node custom DRC - valid at BOTH JLCPCB and PCBWay.
# 4-layer FR-4, 1oz outer + 1oz inner (JLC041611-7628; 2oz outer was rejected
# 2026-09-16, see docs/fab/goals.md), ENIG, impedance-controlled stackup,
# double-sided assembly. Every value below is the STRICTER of the two fabs'
# capability, so the board is buildable at either without a design change.
# Cost-tier surcharges (finer vias/traces) are deliberately NOT encoded here:
# DRC gates manufacturability, not price, and the fab house is not settled.
#
# Target: KiCad 10.0. Paste into Board Setup > Design Rules > Custom Rules,
# click "Check Rule Syntax", then run Inspect > Design Rules Checker (F8).
# The Constraints-page and Net-Class minimums live in parsnip.kicad_pro, NOT
# here - set them to the values in the NOTES block at the bottom of this file.
#
# NOTE ON ORDERING: KiCad evaluates rules in REVERSE (last first) and stops at
# the first match for any object pair. General rules are placed EARLIER, more
# specific rules LATER, so the specific ones win.

# ================= GENERAL CLEARANCE (place early = low priority) =============

# SMD pad-to-pad, different nets: 0.15mm (current JLC sheet)
(rule "SMD Pad to Pad (diff net)"
    (constraint clearance (min 0.15mm))
    (condition "A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Net != B.Net"))

# Pad to track clearance: 0.1mm
(rule "Pad to Track"
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Pad' && B.Type == 'Track'"))

# ================= TRACES =====================================================
# Inner copper: 0.10/0.10mm. JLC multilayer allows 0.09; PCBWay's standard tier
# is 0.10mm (4 mil). 0.10 keeps BOTH fabs at no-surcharge.
(rule "Min Trace Width (inner)"
    (layer inner)
    (constraint track_width (min 0.1mm))
    (condition "A.Type == 'Track'"))

(rule "Min Trace Spacing (inner)"
    (layer inner)
    (constraint clearance (min 0.1mm))
    (condition "A.Type == 'Track' && B.Type == 'Track'"))

# Outer copper: 0.127mm (5 mil). Both fabs build 0.09-0.10mm outer, but outer
# etches less predictably; 5 mil is a deliberate yield margin above both.
(rule "Min Trace Width (outer)"
    (layer outer)
    (constraint track_width (min 0.127mm))
    (condition "A.Type == 'Track'"))

(rule "Min Trace Spacing (outer)"
    (layer outer)
    (constraint clearance (min 0.127mm))
    (condition "A.Type == 'Track' && B.Type == 'Track'"))

# ================= NET-CLASS WIDTH FLOORS (placed after the general trace rules
# so they WIN for these classes; KiCad evaluates last-first) ===================
# The net-class widths in parsnip.kicad_pro are only the ROUTER default. KiCad's
# TRACK_WIDTH DRC checks the board/outer minimum (0.127mm), NOT the class width,
# so a power or RF net necked below its class width passes DRC silently. These
# rules turn that into a hard error.

# Charge / PD path (every PWR_HIGH net in parsnip.kicad_pro: cells, pack, charger,
# input path). The trunks ride on same-net pour bands ("route NET" zones), so the
# copper that carries the current is the fill, not the track: check each trunk with
#   kpcb.py parsnip.kicad_pcb ampacity --from SRC --to LOAD --amps X --fills
# A 1.0mm floor here (until 2026-10-19) could not tell a trunk from a sense,
# thermistor or bypass leg on the same net - KiCad rules have no track length or
# endpoint property - and buried real DRC under ~460 legs, pad stubs and
# pour-backed tracks. What is left is a sanity floor: nothing thinner than 0.2mm.
(rule "pwr_min_width"
    (constraint track_width (min 0.2mm))
    (condition "A.NetClass == 'PWR_HIGH'"))

# ================= DRILL / VIAS ===============================================
# Standard no-surcharge via: 0.2mm hole, 0.5mm diameter -> 0.15mm ring.
(rule "Min Via Hole"
    (constraint hole_size (min 0.2mm))
    (condition "A.Type == 'Via'"))

(rule "Min Via Diameter"
    (constraint via_diameter (min 0.5mm))
    (condition "A.Type == 'Via'"))

# JLCPCB does NOT support blind/buried vias. Catch them for free.
(rule "No blind/buried vias"
    (constraint disallow blind_via buried_via micro_via))

# Plated through-hole (round) size: 0.2mm preferred min, 6.35mm max.
(rule "PTH Hole Size"
    (constraint hole_size (min 0.2mm) (max 6.35mm))
    (condition "A.isPlated() && A.Hole_Size_X == A.Hole_Size_Y"))

# Plated slot (oval) minimum width: 0.5mm
(rule "Plated Slot Width"
    (constraint hole_size (min 0.5mm))
    (condition "A.isPlated() && A.Hole_Size_X != A.Hole_Size_Y"))

# Non-plated holes: 0.5mm min
(rule "Min NPTH Hole"
    (constraint hole_size (min 0.5mm))
    (condition "A.Pad_Type == 'NPTH, mechanical'"))

# Max mechanical drill: 6.3mm
(rule "Max NPTH Hole"
    (constraint hole_size (max 6.3mm))
    (condition "A.Pad_Type == 'NPTH, mechanical'"))

# Castellated holes: 0.5mm min
(rule "Min Castellated Hole"
    (constraint hole_size (min 0.5mm))
    (condition "A.Fabrication_Property == 'Castellated pad'"))

# ================= ANNULAR RING ===============================================
# Both fabs: 0.15mm absolute min ring on multilayer 1oz vias and PTH pads
# (both also *recommend* 0.20mm). The board's vias are 0.5/0.2, 0.6/0.3 and 0.8/0.4 mm,
# all at least a 0.15mm ring.
# Excludes castellated pads (half-holes have unusual ring geometry).
(rule "Min Annular Ring"
    (constraint annular_width (min 0.15mm))
    (condition "A.isPlated() && A.Fabrication_Property != 'Castellated pad'"))

# ================= HOLE-TO-HOLE / HOLE CLEARANCES =============================
# Pad-to-pad (with hole), different nets: 0.45mm
(rule "Hole-to-hole (pads, diff net)"
    (constraint hole_to_hole (min 0.45mm))
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Net != B.Net"))

# Via-to-via, different nets: 0.2mm
(rule "Hole-to-hole (vias, diff net)"
    (constraint hole_to_hole (min 0.2mm))
    (condition "A.Type == 'Via' && B.Type == 'Via' && A.Net != B.Net"))

# Via hole to track: 0.2mm (measured from hole edge)
(rule "Via Hole to Track"
    (constraint hole_clearance (min 0.2mm))
    (condition "A.Type == 'Via' && B.Type == 'Track'"))

# PTH hole to track: 0.28mm min (0.35mm recommended)
(rule "PTH Hole to Track"
    (constraint hole_clearance (min 0.28mm))
    (condition "A.isPlated() && A.Type == 'Pad' && B.Type == 'Track'"))

# NPTH to track: 0.2mm
(rule "NPTH Hole to Track"
    (constraint hole_clearance (min 0.2mm))
    (condition "A.Pad_Type == 'NPTH, mechanical' && B.Type == 'Track'"))

# ================= SILKSCREEN =================================================
(rule "Min Silkscreen Text"
    (layer "?.Silkscreen")
    (constraint text_thickness (min 0.15mm))
    (constraint text_height (min 1.0mm)))

(rule "Pad to Silkscreen"
    (layer outer)
    (constraint silk_clearance (min 0.15mm))
    (condition "A.Type == 'Pad' && (B.Type == 'Text' || B.Type == 'Graphic')"))

# ================= BOARD OUTLINE ==============================================
# Copper to routed board edge / slot: 0.3mm (includes router tolerance).
# JLC min 0.2mm, PCBWay min 0.25mm - 0.3mm clears both with margin.
(rule "Copper to Board Edge"
    (constraint edge_clearance (min 0.3mm))
    (condition "A.Type == 'Track' || A.Type == 'Pad' || A.Type == 'Via' || A.Type == 'Zone'"))

# ================= NOTES: values that live in parsnip.kicad_pro ===============
# The .dru cannot set the Constraints-page floors, the solder-mask web width, or
# the net-class widths - those are in parsnip.kicad_pro. Set them in Board Setup
# to the values below (stricter of JLCPCB/PCBWay). Current .pro values that are
# looser than a fab standard are flagged [FIX].
#
# Board Setup > Constraints:
#   Min track width ............ 0.10 mm   (.pro = 0.10)
#   Min clearance .............. 0.10 mm   (.pro = 0.10)
#   Min connection width ....... 0.10 mm   (.pro = 0.10)
#   Copper to edge ............. 0.25 mm   (.pro = 0.20; DRU rule already 0.30)
#   Min via diameter ........... 0.50 mm   (drill floor 0.20; board uses 0.30)
#   Min through-hole diameter .. 0.20 mm
#   Min via annular width ...... 0.15 mm
#   Min hole-to-hole ........... 0.20 mm
#   Min hole clearance ......... 0.20 mm
#   Blind/buried/micro vias .... disallow  (neither fab supports them)
#
# Board Setup > Solder Mask/Paste:
#   Solder mask min web width .. 0.10 mm   (JLC/PCBWay mask bridge on 1oz green;
#                                            use 0.13 mm if you pick black/white)
#
# Board Setup > Physical Stackup (already correct, do not regress):
#   Surface finish ............. ENIG      (required by the 0.35mm X2SON /
#                                            0.4mm QFN fine pitch - HASL can't)
#   Impedance controlled ....... yes       (order the impedance option; hold
#                                            the RF netclass widths below)
#
# Net classes (Board Setup > Net Classes) - already both-fab-safe, no change:
#   RF_50OHM     track 0.306 / clearance 0.20  (CPWG: gap to side GND pour)
#   RF_50OHM_MS  track 0.34  / clearance 0.80  (microstrip, GND kept away)
#   PWR_RAIL 0.60   PWR_HIGH 1.50
#   Check routed RF with `kpcb.py parsnip.kicad_pcb rf` (field-solved Zo on the
#   board's own stackup) rather than trusting these numbers.
#
# ================= FAB NOTES ==================================================
# NOT DRC-checkable, but required for DOUBLE-SIDED ASSEMBLY at either house:
#   - Fiducials: >=3 global fiducials (1mm copper / 2mm mask), both sides if
#     both sides are placed. PCBWay assembly requires them; JLC strongly prefers.
#   - Edge rails / tooling strip: PCBWay assembly requires rails; JLC SMT wants
#     5mm tooling edges + 2mm tooling holes + 1mm fiducials for a panel.
#   - Fine pitch: the 0.35mm-pitch X2SON exceeds JLC *Economic* assembly
#     (0.4mm min IC pitch). It needs JLC *Standard* assembly or PCBWay (0.35mm).

# ================= UNFUSED PACK POSITIVE (2026-09-24) =========================
# /BMS/CELL_TOP is the cell stack + upstream of F5. A short from it to pack negative
# (-BATT, GND through the 5 mOhm shunt, or the raw cell minus /BMS/CELL_BOT) is an
# unfused dead short of both cells that bypasses F5, Q5/Q6 and R41. Keep those nets
# 0.4 mm away, pour fills included. Placed last so it is evaluated first.
(rule "unfused_pack_plus"
    (constraint clearance (min 0.4mm))
    (condition "A.NetName == '/BMS/CELL_TOP' && (B.NetName == '-BATT' || B.NetName == 'GND' || B.NetName == '/BMS/CELL_BOT')"))
